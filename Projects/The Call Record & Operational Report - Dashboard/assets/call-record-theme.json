{
  "name": "Call Record Analysis Theme V2",
  "dataColors": [
    "#2b5797",
    "#1e3a8a",
    "#3b82f6",
    "#e65c00",
    "#f97316",
    "#10b981",
    "#6366f1",
    "#8b5cf6"
  ],
  "background": "#f8fafc",
  "foreground": "#0f172a",
  "tableAccent": "#1e3a8a",
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#f1f5f9" } },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#ffffff" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#e2e8f0" } },
            "radius": 4
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": false,
            "transparency": 100
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "general": [
          {
            "visualHeader": false
          }
        ]
      }
    }
  }
}